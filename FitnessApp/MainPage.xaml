<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            x:Class="FitnessApp.MainPage">

    <ScrollView>
    <VerticalStackLayout Padding="30" Spacing="20">
        
        <Image Source="dotnet_bot.png" HeightRequest="100" HorizontalOptions="Center" />
        <Label Text="My Fitness Tracker" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#4CAF50"/>

        <Frame CornerRadius="10" BorderColor="#D3D3D3" Padding="10">
            <VerticalStackLayout Spacing="10">
                <Label Text="Τι φάγατε σήμερα;" FontSize="16" />
                <Entry x:Name="FoodEntry" Placeholder="π.χ. Μήλο" Keyboard="Text" />
                <Button Text="Αναζήτηση" Clicked="OnSearchClicked" BackgroundColor="#4CAF50" />
            </VerticalStackLayout>
        </Frame>

        <Label x:Name="ResultLabel" Text="Περιμένω δεδομένα..." FontSize="18" HorizontalOptions="Center" Margin="0,20,0,0" />

    </VerticalStackLayout>
</ScrollView>

</ContentPage>
