<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            x:Class="FitnessApp.MainPage"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#1a1a1a}">

<!-- Grid (Overlay, bottomsheet) -->
        <Grid>

            <!-- Main Page -->
            <ScrollView>
                <VerticalStackLayout Padding="30" Spacing="20">

                    <!-- Image for Page -->
                    <Image Source="dotnet_bot.png" HeightRequest="100" HorizontalOptions="Center" />
                
                    <!-- Title App -->
                    <Label Text="DailyBite" FontSize="28" FontAttributes="Bold" 
                        HorizontalOptions="Center" TextColor="#4CAF50"/>

            <!-- Search Card -->
            <Frame CornerRadius="10" BorderColor="#D3D3D3" Padding="10">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Τι φάγατε σήμερα;" FontSize="16" />
                    <Entry x:Name="FoodEntry" Placeholder="π.χ. Μήλο" PlaceholderColor="Gray" 
                        TextColor="{AppThemeBinding Light=Black, Dark=White}" 
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#333333}" 
                        Keyboard="Text" />
                    <Button Text="Αναζήτηση" Clicked="OnSearchClicked" BackgroundColor="#FF00FF33" />
                </VerticalStackLayout>
            </Frame>
        
            <!-- Search Results -->
            <Label x:Name="ResultLabel" Text="Περιμένω δεδομένα..." FontSize="18" 
                    HorizontalOptions="Center" Margin="0,20,0,0" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Menu button - Bottom Right, arround -->
        <Button Text="☰"
            FontSize="28"
            WidthRequest="60"
            HeightRequest="60"
            CornerRadius="30"
            BackgroundColor="#0F1D2D"
            TextColor="White"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,20,30"
            Clicked="OnMenuClicked"
            ZIndex="10"/>

        <!-- Dark overlay behind the menu, closes the menu when you click on it -->
        <BoxView x:Name="Overlay"
                Color="Black"
                Opacity="0"
                IsVisible="False"
                ZIndex="20">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnOverlayTapped"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Bottom Sheet - the window that pops up with the options -->
        <Frame x:Name="BottomSheet"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#2a2a2a}"
                CornerRadius="20"
                Padding="20"
                VerticalOptions="End"
                IsVisible="False"
                ZIndex="30"
                TranslationY="400">
            <VerticalStackLayout Spacing="0">
                
                <!-- Bar at the top to show that it is sliding -->
                <BoxView HeightRequest="4" 
                        WidthRequest="50"
                        Color="#CCCCCC"
                        CornerRadius="2"
                        HorizontalOptions="Center"
                        Margin="0,0,0,20"/>
                
                <!-- Select Profile -->
                <Button Text="👤  Προφίλ"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light=Black, Dark=White}"
                        FontSize="18"
                        HorizontalOptions="Fill"
                        Clicked="OnSettingsClicked"/>

                <BoxView HeightRequest="1"
                        Color="#EEEEEE"
                        Margin="0,5"/>
                
                <Button Text="⚙️  Ρυθμίσεις"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light=Black, Dark=White}"
                        FontSize="18"
                        HorizontalOptions="Fill"
                        Clicked="OnSettingsClicked"/>

                <!-- Statistics Selection -->
                <Button Text="📊  Στατιστικά"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light=Black, Dark=White}"
                        FontSize="18"
                        HorizontalOptions="Fill"
                        Clicked="OnStatsClicked"/>
            
                <BoxView HeightRequest="1" 
                        Color="#EEEEEE"
                        Margin="0,5"/>

                <Button Text="🚪  Έξοδος"
                        BackgroundColor="Transparent"
                        TextColor="#FF4444"
                        FontSize="18"
                        HorizontalOptions="Fill"
                        Clicked="OnLogoutClicked"/>

            </VerticalStackLayout>
        </Frame>
    </Grid>
</ContentPage>
